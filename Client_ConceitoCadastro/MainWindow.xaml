<Window x:Class="Client_ConceitoCadastro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consulta CEP" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" VerticalAlignment="Top">

        <!-- Entrada do CEP -->
        <TextBox Text="{Binding Cep, UpdateSourceTrigger=PropertyChanged}"
                 Width="200" Height="25"
                 Margin="0,0,0,10"
                 />
        <!--PlaceholderText/PlaceholderText="Digite o CEP"-->

        <!-- Botão que dispara LookupCommand -->
        <Button Content="Buscar"
                Command="{Binding LookupCommand}"
                Width="100" Height="30"
                HorizontalAlignment="Left"/>

        <!-- Resultados -->
        <StackPanel Margin="0,20,0,0">
            <TextBlock Text="Logradouro:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Street}"/>

            <TextBlock Text="Bairro:" FontWeight="Bold" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding Neighborhood}"/>

            <TextBlock Text="Cidade:" FontWeight="Bold" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding City}"/>

            <TextBlock Text="Estado:" FontWeight="Bold" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding State}"/>
        </StackPanel>

    </StackPanel>
</Window>
