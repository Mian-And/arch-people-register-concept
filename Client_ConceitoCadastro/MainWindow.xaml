<Window x:Class="Client_ConceitoCadastro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consulta CEP" Height="550" Width="420"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" VerticalAlignment="Top">
        <TextBlock Text="Recipient name" FontWeight="Bold"/>
        <TextBox Text="{Binding RecipientName, UpdateSourceTrigger=PropertyChanged}" />

        <Separator Margin="0,14,0,14"/>
        
        <TextBlock Text="CEP" FontWeight="Bold"/>
        <TextBox Text="{Binding Cep, UpdateSourceTrigger=PropertyChanged}"
     Width="200" Height="26" Margin="0,4,0,8"/>

        <Button Content="Buscar" Command="{Binding LookupCommand}"
    Width="110" Height="30" HorizontalAlignment="Right"/>

        <UniformGrid Columns="2" Rows="4" HorizontalAlignment="Left" Margin="0,0,0,8">
            <TextBlock Text="Street:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Street}"/>
            <TextBlock Text="Neighborhood:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Neighborhood}"/>
            <TextBlock Text="City:" FontWeight="Bold"/>
            <TextBlock Text="{Binding City}"/>
            <TextBlock Text="State:" FontWeight="Bold"/>
            <TextBlock Text="{Binding State}"/>
        </UniformGrid>

        <TextBlock Text="House number" FontWeight="Bold" Margin="0,8,0,0"/>
        <TextBox Text="{Binding HouseNumber, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Complement" FontWeight="Bold" Margin="0,8,0,0"/>
        <TextBox Text="{Binding Complement, UpdateSourceTrigger=PropertyChanged}" />


        <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" FontStyle="Italic"/>

        <TextBlock Text="Message" FontWeight="Bold" Margin="0,8,0,0"/>
        <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80"/>

        <!-- CEP + Lookup já existentes -->
        <WrapPanel Margin="0,10,0,10">
            <TextBox Width="120" Text="{Binding Cep, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Lookup CEP" Command="{Binding LookupCommand}" Margin="8,0,0,0"/>
        </WrapPanel>

        <!-- Endereço resolvido -->
        <!-- Street, Neighborhood, City, State -->

        <Button Content="Save" Command="{Binding SaveCommand}" Width="120" />
    </StackPanel>
</Window>